# Copie para .env e preencha somente na publicação. Veja a seção "Configuração" do README.

# Domínio de produção, com https e sem barra no final. Confirme com o cliente antes de preencher.
# Sem este valor o site é tratado como preview: sem canônicas, sem sitemap e com noindex.
PUBLIC_SITE_URL=

# Use "true" somente no build de produção. Qualquer outro valor mantém o noindex.
PUBLIC_INDEXABLE=false

# Preencha um dos dois. Se ambos existirem, o GTM tem prioridade e o GA4 deve ser configurado dentro dele.
PUBLIC_GTM_ID=
PUBLIC_GA4_ID=

# Link direto do Perfil da Empresa no Google. Quando preenchido, aparece no rodapé, em /contato/ e no sameAs do JSON-LD.
PUBLIC_GOOGLE_BUSINESS_URL=

# Observação: o host de produção usado pelo Worker (X-Robots-Tag) NÃO fica aqui, e sim em wrangler.jsonc, na variável PRODUCTION_HOST.
